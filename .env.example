# Padartha-Vidyagara — environment variables (example)
#
# Copy to `.env.local` and fill in the values. None of these are required
# for `npm run build`; the build must succeed without contacting any
# external service (vision Part XI — no telemetry, no network during
# build). Leaving ANTHROPIC_API_KEY unset will make the purvapakshin
# route return 503, which is the intended development default.

# Anthropic API key for the purvapakshin dialogue engine.
# When unset, /api/purvapakshin returns 503 and the client surfaces
# "the purvapakshin is offline". The build never reads it.
ANTHROPIC_API_KEY=
