# Padartha-Vidyagara — environment variables (example)
#
# Copy to `.env.local` and fill in the values. None of these are required
# for `npm run build`; the build must succeed without contacting any
# external service (vision Part XI — no telemetry, no network during
# build). Leaving both API keys unset will make the purvapakshin route
# return 503, which is the intended development default.

# ---- LLM provider for the purvapakshin dialogue engine -------------
#
# The route supports two providers; configure at least one:
#
#   ANTHROPIC_API_KEY — claude-sonnet-4-6   (default model)
#   GEMINI_API_KEY    — gemini-pro-latest   (default model; alias auto-
#                                            tracks the latest Gemini Pro)
#
# Selection order:
#   1. If LLM_PROVIDER is set to `anthropic` or `gemini`, that one wins
#      (and 503 if its key is missing — explicit choice wins).
#   2. Otherwise prefer Anthropic if ANTHROPIC_API_KEY is set.
#   3. Otherwise Gemini if GEMINI_API_KEY is set.
#   4. Otherwise 503.
#
# Both routes go through the same system prompt and `[position_id]`
# tagging — the engine is provider-agnostic; only the SDK call differs.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Force a specific provider regardless of which keys are set.
# Values: anthropic | gemini
# Leave unset to use the auto-selection order above.
LLM_PROVIDER=
